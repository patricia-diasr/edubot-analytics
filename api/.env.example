# Copie este arquivo para ".env" e preencha com valores reais.
# O .env nunca deve ser versionado (já está no .gitignore).

# Obrigatória: a API não inicia sem ela. Mínimo de 32 caracteres.
# Gere uma chave própria com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Senhas dos usuários de teste (aluno.teste, aluno.teste2, aluno.teste3).
# Usuário sem senha definida não é criado.
SEED_PASSWORD_ALUNO1=
SEED_PASSWORD_ALUNO2=
SEED_PASSWORD_ALUNO3=

# Opcionais (valores padrão em app/core/config.py)
# DATABASE_URL=sqlite:///./edubot.db
# ACCESS_TOKEN_EXPIRE_MINUTES=30
# RATE_LIMIT_LOGIN=5/minute
# RATE_LIMIT_PREDICT=20/minute
# TRUSTED_PROXY_HOPS=0
# CORS_ORIGINS=["http://localhost:3000"]
